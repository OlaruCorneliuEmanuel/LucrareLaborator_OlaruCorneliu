<Window x:Class="InterfataWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autentificare Sistem" Height="400" Width="420" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        Background="#E5E7E9">

    <Grid Margin="25">
        <Border Background="White" CornerRadius="8" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.1" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Autentificare" FontSize="26" FontFamily="Segoe UI" FontWeight="Bold" 
                           Foreground="#1B4F72" HorizontalAlignment="Center" Margin="0,20,0,25"/>

                <Label Content="Utilizator:" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Padding="0,0,0,5"/>
                <TextBox x:Name="txtUser" Height="35" FontSize="15" Padding="5,0" Margin="0,0,0,15"
                         VerticalContentAlignment="Center" Background="#F8F9F9"/>

                <Label Content="Parolă:" FontSize="14" FontWeight="SemiBold" Foreground="#34495E" Padding="0,0,0,5"/>
                <PasswordBox x:Name="txtPass" Height="35" FontSize="15" Padding="5,0" Margin="0,0,0,25"
                             VerticalContentAlignment="Center" Background="#F8F9F9"/>

                <Button Content="LOGIN" Height="40" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                        Background="#1B4F72" Foreground="White" 
                        Click="btnLogin_Click" IsDefault="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="tbEroare" Foreground="#C94F2C" FontSize="13" FontWeight="SemiBold" 
                           Margin="0,15,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>