<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiune Închirieri Auto" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Coloana stângă pentru formular (lățime fixă) și coloana dreaptă pentru Tabel (ia restul spațiului cu *) -->
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PARTEA STÂNGĂ: Formular de introducere date (Aranjate vertical cu StackPanel) -->
        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,15,0">

            <Label Content="Nume Client:"/>
            <TextBox x:Name="txtNumeClient" Height="25" Margin="0,0,0,5"/>

            <Label Content="Prenume Client:"/>
            <TextBox x:Name="txtPrenumeClient" Height="25" Margin="0,0,0,5"/>

            <!-- ComboBox Cerut la Test -->
            <Label Content="Marca Mașină:"/>
            <ComboBox x:Name="cmbMarca" Height="25" Margin="0,0,0,5">
                <ComboBoxItem Content="Selectează marca..."/>
                <ComboBoxItem Content="Dacia"/>
                <ComboBoxItem Content="Renault"/>
                <ComboBoxItem Content="Toyota"/>
                <ComboBoxItem Content="Ford"/>
            </ComboBox>

            <!-- DatePicker Cerut la Test -->
            <Label Content="Data Închirierii:"/>
            <DatePicker x:Name="dpDataInchiriere" Height="25" Margin="0,0,0,5"/>

            <Label Content="Număr de Zile:"/>
            <TextBox x:Name="txtZile" Height="25" Margin="0,0,0,10"/>

            <!-- RadioButtons Cerute la Test (Grupate prin GroupName) -->
            <Label Content="Combustibil:"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <RadioButton x:Name="rbBenzina" Content="Benzină" IsChecked="True" GroupName="Combustibil" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbMotorina" Content="Motorină" GroupName="Combustibil" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbElectric" Content="Electric" GroupName="Combustibil"/>
            </StackPanel>

            <!-- Mesaj pentru Erori de Validare -->
            <TextBlock x:Name="tbEroare" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- Butoanele Cerute la Test (Aranjate orizontal) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAdauga" Content="Adaugă" Width="70" Margin="2" Click="btnAdauga_Click"/>
                <Button x:Name="btnAfiseaza" Content="Afișează" Width="70" Margin="2" Click="btnAfiseaza_Click"/>
                <Button x:Name="btnFiltreaza" Content="Filtrează" Width="70" Margin="2" Click="btnFiltreaza_Click"/>
            </StackPanel>

        </StackPanel>

        <!-- PARTEA DREAPTĂ: Afișare Date în Tabel -->
        <DataGrid x:Name="dgInchirieri" Grid.Column="1" AutoGenerateColumns="True" IsReadOnly="True" />

    </Grid>
</Window>