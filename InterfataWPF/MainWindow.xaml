<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRent - Enterprise Edition" Height="600" Width="1050" WindowStartupLocation="CenterScreen" Background="#F0F3F4">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Bold"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- MENIU SUPERIOR -->
        <Menu DockPanel.Dock="Top" Background="#1A5276" Foreground="White" FontSize="14" Padding="8">
            <MenuItem Header="_Fișier">
                <MenuItem Header="_Ieșire" Click="MeniuIesire_Click" Foreground="Black"/>
            </MenuItem>
            <MenuItem Header="_Navigare Dashboard">
                <MenuItem Header="_Contracte Active" Click="btnMeniuInchirieri_Click" Foreground="Black"/>
                <MenuItem Header="_Inventar Flotă" Click="btnMeniuFlota_Click" Foreground="Black"/>
            </MenuItem>
        </Menu>

        <!-- BARA DE STATUS (JOS) -->
        <StatusBar DockPanel.Dock="Bottom" Background="#1A5276" Foreground="White" Padding="10,5">
            <StatusBarItem>
                <TextBlock x:Name="tbStatusStanga" Text="Sistem conectat. Gata de operare." FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="tbStatisticiLive" Text="Statistici se încarcă..." FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ZONA CENTRALĂ -->
        <Grid Margin="15">
            <!-- PANEL 1: ÎNCHIRIERI -->
            <Grid x:Name="panelInchirieri" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="EMITERE CONTRACT NOU" FontWeight="Bold" FontSize="14" Margin="0,0,15,0" Padding="10">
                    <StackPanel>
                        <Label Content="Nume client:" Margin="0,5,0,0"/>
                        <TextBox x:Name="txtNumeClient" Height="28" Padding="5" VerticalContentAlignment="Center"/>

                        <Label Content="Prenume:"/>
                        <TextBox x:Name="txtPrenumeClient" Height="28" Padding="5" VerticalContentAlignment="Center"/>

                        <Label Content="Alege mașina (Doar libere):"/>
                        <ComboBox x:Name="cmbMasinaSelectata" Height="28" ItemsSource="{Binding MasiniDisponibile}" DisplayMemberPath="DetaliiAfisare" Padding="5"/>

                        <Label Content="Data închiriere:"/>
                        <DatePicker x:Name="dpDataInchiriere" Height="28"/>

                        <Label Content="Număr zile:"/>
                        <TextBox x:Name="txtZile" Height="28" Padding="5" VerticalContentAlignment="Center"/>

                        <Button Content="SALVEAZĂ CONTRACT" Click="btnAdauga_Click" Margin="0,20,0,0" Background="#27AE60"/>
                        <TextBlock x:Name="tbEroare" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="🔍 Căutare live client:" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCautare" Width="250" Height="30" Padding="5" VerticalContentAlignment="Center" TextChanged="txtCautare_TextChanged"/>
                            <Button Content="Returnează Mașina (Șterge)" Click="btnSterge_Click" Background="#C0392B" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="dgInchirieri" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#EAEDED" RowHeight="30" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nume" Binding="{Binding Client.Nume}" Width="100"/>
                            <DataGridTextColumn Header="Prenume" Binding="{Binding Client.Prenume}" Width="100"/>
                            <DataGridTextColumn Header="Mașină Închiriată" Binding="{Binding Automobil.DetaliiAfisare}" Width="200"/>
                            <DataGridTextColumn Header="Zile" Binding="{Binding NumarZile}" Width="50"/>
                            <DataGridTextColumn Header="Dată" Binding="{Binding DataInchiriere, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- PANEL 2: FLOTĂ MAȘINI -->
            <Grid x:Name="panelMasini" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="ADAUGĂ ÎN INVENTAR" FontWeight="Bold" FontSize="14" Margin="0,0,15,0" Padding="10">
                    <StackPanel>
                        <Label Content="Marca mașinii:"/>
                        <TextBox x:Name="txtMarca" Height="28" Padding="5"/>
                        <Label Content="Model:"/>
                        <TextBox x:Name="txtModel" Height="28" Padding="5"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <Label Content="Culoare:"/>
                                <ComboBox x:Name="cmbCuloare" Height="28">
                                    <ComboBoxItem Content="Alb" IsSelected="True"/>
                                    <ComboBoxItem Content="Negru"/>
                                    <ComboBoxItem Content="Rosu"/>
                                    <ComboBoxItem Content="Albastru"/>
                                    <ComboBoxItem Content="Gri"/>
                                    <ComboBoxItem Content="Verde"/>
                                    <ComboBoxItem Content="Galben"/>
                                    <ComboBoxItem Content="Portocaliu"/>
                                    <ComboBoxItem Content="Maro"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <Label Content="Motorizare:"/>
                                <ComboBox x:Name="cmbCombustibil" Height="28">
                                    <ComboBoxItem Content="Benzina" IsSelected="True"/>
                                    <ComboBoxItem Content="Motorina"/>
                                    <ComboBoxItem Content="Electric"/>
                                    <ComboBoxItem Content="Hibrid"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Label Content="Echipări Premium:" Margin="0,10,0,0"/>
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="5" Background="#FDFEFE">
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkAer" Content="Climă" Margin="5"/>
                                <CheckBox x:Name="chkNavigatie" Content="Navi" Margin="5"/>
                                <CheckBox x:Name="chkSenzori" Content="Senzori" Margin="5"/>
                                <CheckBox x:Name="chkCamera" Content="Cameră" Margin="5"/>
                                <CheckBox x:Name="chkBluetooth" Content="Bluetooth" Margin="5"/>
                                <CheckBox x:Name="chkIncalzire" Content="Încălzire Scaune" Margin="5"/>
                                <CheckBox x:Name="chkFaruri" Content="Faruri LED" Margin="5"/>
                                <CheckBox x:Name="chkPilot" Content="Pilot Automat" Margin="5"/>
                            </WrapPanel>
                        </Border>

                        <Button Content="ADAUGĂ MAȘINĂ" Click="btnAdaugaMasina_Click" Margin="0,20,0,0"/>
                        <Button Content="RADIAZĂ MAȘINĂ (Șterge)" Click="btnStergeMasina_Click" Background="#E67E22"/>
                    </StackPanel>
                </GroupBox>

                <DataGrid x:Name="dgMasini" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#EAEDED" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stare" Binding="{Binding EsteInchiriata}" Width="70"/>
                        <DataGridTextColumn Header="Marcă" Binding="{Binding Marca}" Width="100"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                        <DataGridTextColumn Header="Culoare" Binding="{Binding CuloareMasina}" Width="80"/>
                        <DataGridTextColumn Header="Combustibil" Binding="{Binding Combustibil}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>